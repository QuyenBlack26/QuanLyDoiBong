<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/black"
    android:padding="12dp">

    <!-- Column 1: Date -->
    <TextView
        android:id="@+id/tvMatchDateResult"
        android:layout_width="45dp"
        android:layout_height="wrap_content"
        android:text="07.07."
        android:textColor="@color/text_secondary_gray"
        android:textSize="12sp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Column 2: Teams -->
    <LinearLayout
        android:id="@+id/layoutTeamsResult"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:orientation="vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/tvMatchDateResult"
        app:layout_constraintEnd_toStartOf="@id/layoutScoresResult">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <ImageView
                android:id="@+id/ivHomeFlagResult"
                android:layout_width="16dp"
                android:layout_height="12dp"
                android:src="@android:drawable/ic_menu_gallery" />
            <TextView
                android:id="@+id/tvHomeTeamResult"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Bồ Đào Nha"
                android:textColor="@color/text_primary_white"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <ImageView
                android:id="@+id/ivAwayFlagResult"
                android:layout_width="16dp"
                android:layout_height="12dp"
                android:src="@android:drawable/ic_menu_gallery" />
            <TextView
                android:id="@+id/tvAwayTeamResult"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Pháp"
                android:textColor="@color/text_primary_white"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Column 3: Scores and Badge -->
    <LinearLayout
        android:id="@+id/layoutScoresResult"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">
            <TextView
                android:id="@+id/tvScoreHomeResult"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="@color/text_primary_white"
                android:textSize="14sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/tvScoreAwayResult"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="0"
                android:textColor="@color/text_primary_white"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <androidx.cardview.widget.CardView
            android:id="@+id/cardResultBadge"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="16dp"
            app:cardBackgroundColor="@color/draw_yellow"
            app:cardCornerRadius="2dp"
            app:cardElevation="0dp">
            <TextView
                android:id="@+id/tvResultStatusText"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="H"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:textStyle="bold" />
        </androidx.cardview.widget.CardView>
    </LinearLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:background="#22FFFFFF"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
